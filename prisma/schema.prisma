generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  username       String?         @unique
  password       String?
  email          String?         @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  apiKey         String?
  createdAt      DateTime        @default(now())
  conversations  Conversation[]
  accounts       Account[]
  sessions       Session[]
  knowledgeBases KnowledgeBase[]
  
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PendingAccountLink {
  id                String   @id @default(cuid())
  email             String
  provider          String
  providerAccountId String
  token             String   @unique
  expires           DateTime
  createdAt         DateTime @default(now())

  @@unique([email, provider])
  @@index([token])
  @@index([expires])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resourceId])
}

model Conversation {
  id           String    @id @default(cuid())
  title        String    @default("新对话")
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  shareToken   String?   @unique
  isShared     Boolean   @default(false)
  sharedAt     DateTime?
  isPinned     Boolean   @default(false)
  pinnedAt     DateTime?

  @@index([userId, updatedAt(sort: Desc)])
  @@index([shareToken])
  @@index([userId, isPinned, pinnedAt(sort: Desc)])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  thinking       String?      @db.Text
  toolCalls      Json?
  toolResults    Json?        // 工具执行结果 [{ toolCallId, name, result }]
  attachments    Json?        // 文件附件列表 [{ name, type, size }]
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}


// 监控事件表 - 存储 @sky-monitor/sdk 上报的埋点数据
// 维度字段（appId/sessionId/traceId）从 context 解析为独立列，便于聚合查询
model MonitorEvent {
  id        String   @id // 事件 ID（SDK 生成，用于去重）
  type      String // 事件类型: sse_start, sse_complete, js_error, http_request ...
  timestamp DateTime // 事件发生时间（客户端时间戳）
  data      Json // 事件载荷: { traceId, ttfb, duration, ... }
  context   Json // 完整上下文: { appId, sessionId, traceId, ... }
  appId     String? // 应用标识（从 context 解析）
  sessionId String? // 会话 ID（从 context 解析）
  traceId   String? // Trace ID（从 context 解析）
  createdAt DateTime @default(now())

  @@index([type, timestamp])
  @@index([sessionId, timestamp])
  @@index([traceId])
  @@index([appId, timestamp])
}

// ============ RAG 私有知识库 ============
// 检索结果是 knowledge_search 工具的返回内容，向量以 Float[]（PostgreSQL double precision[]）
// 存储，相似度在应用层计算（见 server/services/rag/）。当前库无 pgvector 扩展，
// 故不使用 vector 类型；规模增长后可迁移到 pgvector，chunk 表结构无需改动。

model KnowledgeBase {
  id          String              @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   KnowledgeDocument[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
}

model KnowledgeDocument {
  id              String          @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase   @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  name            String
  type            String // 'txt' | 'md'（与 /api/upload 支持的扩展名一致）
  size            Int
  status          String          @default("ready") // ready | failed
  error           String?         @db.Text
  chunkCount      Int             @default(0)
  createdAt       DateTime        @default(now())
  chunks          DocumentChunk[]

  @@index([knowledgeBaseId, createdAt])
}

model DocumentChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int // 文档内序号，用于展示与去重
  content    String            @db.Text
  embedding  Float[] // 与 EMBEDDING_MODELS[].dimensions 对应
  createdAt  DateTime          @default(now())

  @@index([documentId, index])
}
