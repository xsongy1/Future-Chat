generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  username       String?         @unique
  password       String?
  email          String?         @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  apiKey         String?
  createdAt      DateTime        @default(now())
  conversations  Conversation[]
  accounts       Account[]
  sessions       Session[]
  knowledgeBases KnowledgeBase[]
  ragTasks       RagTask[]
  
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PendingAccountLink {
  id                String   @id @default(cuid())
  email             String
  provider          String
  providerAccountId String
  token             String   @unique
  expires           DateTime
  createdAt         DateTime @default(now())

  @@unique([email, provider])
  @@index([token])
  @@index([expires])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resourceId])
}

model Conversation {
  id           String    @id @default(cuid())
  title        String    @default("新对话")
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  shareToken   String?   @unique
  isShared     Boolean   @default(false)
  sharedAt     DateTime?
  isPinned     Boolean   @default(false)
  pinnedAt     DateTime?
  // 下面两列由迁移 20251112161305_add_pending_link_and_audit 添加，但一度从模型里消失：
  // 数据库里有列、schema 里没字段 = drift，任何一次 prisma migrate dev 都会生成
  // DROP COLUMN（viewCount 是有数据的），属于静默的丢数据风险。补回声明以消除 drift。
  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  // ============ 上下文管理：长期记忆（Recent Window + Summary）============
  /// 历史压缩摘要。窗口负责"最近的对话"，摘要负责"更早的对话"，
  /// 两者合起来才是模型看到的完整历史。由 server/services/chat/context 维护。
  summary              String?   @db.Text
  /// 摘要最后写入时间。除了可观测，它还兼任并发压缩的 CAS 版本号：
  /// 两个请求同时压缩时，只有读到同一个旧值的那个能写成功（见 ConversationRepository.saveSummary）。
  summaryUpdatedAt     DateTime?
  /// 摘要覆盖到的最后一条消息 ID（水位线）。下次压缩据此只摘要"水位线之后"的新内容，
  /// 而不是把整段历史重摘一遍——这是摘要成本不随对话长度线性增长的关键。
  summaryUpToMessageId String?

  @@index([userId, updatedAt(sort: Desc)])
  @@index([shareToken])
  @@index([userId, isPinned, pinnedAt(sort: Desc)])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  thinking       String?      @db.Text
  toolCalls      Json?
  toolResults    Json?        // 工具执行结果 [{ toolCallId, name, result }]
  attachments    Json?        // 文件附件列表 [{ name, type, size }]
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}


// 监控事件表 - 存储 future-monitor-sdk 上报的埋点数据
// 维度字段（appId/sessionId/traceId）从 context 解析为独立列，便于聚合查询
model MonitorEvent {
  id        String   @id // 事件 ID（SDK 生成，用于去重）
  type      String // 事件类型: sse_start, sse_complete, js_error, http_request ...
  timestamp DateTime // 事件发生时间（客户端时间戳）
  data      Json // 事件载荷: { traceId, ttfb, duration, ... }
  context   Json // 完整上下文: { appId, sessionId, traceId, ... }
  appId     String? // 应用标识（从 context 解析）
  sessionId String? // 会话 ID（从 context 解析）
  traceId   String? // Trace ID（从 context 解析）
  createdAt DateTime @default(now())

  @@index([type, timestamp])
  @@index([sessionId, timestamp])
  @@index([traceId])
  @@index([appId, timestamp])
}

// ============ RAG 私有知识库 ============
// 检索结果是 knowledge_search 工具的返回内容。混合检索由两条通道组成：
//   1. 向量通道：embedding 同时存 Float[]（Prisma 可直接读写的原始向量）与
//      embeddingVec vector(1024)（pgvector 列，相似度下推成 SQL，走 HNSW 索引）。
//      两份数据不是冗余设计，而是「有 pgvector 用 SQL、没有就回退应用层精确扫描」的开关：
//      Prisma 不支持 vector 类型，读写 embeddingVec 只能走 $queryRaw（见 vector-store.ts）。
//   2. 词法通道：tsv tsvector 存 CJK bigram + 拉丁词项，配合 GIN 索引做 BM25
//      （词项切分见 tokenizer.ts，两边的词项必须完全一致，否则永远匹配不上）。

model KnowledgeBase {
  id          String              @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   KnowledgeDocument[]
  tasks       RagTask[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
}

model KnowledgeDocument {
  id              String          @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase   @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  name            String
  type            String // 'txt' | 'md'（与 /api/upload 支持的扩展名一致）
  size            Int
  // pending | processing | ready | failed
  // 入库改为任务队列后，创建文档与完成向量化是两件事：先落 pending 再入队，
  // 因此默认值不再是 ready——否则接口一返回就「看起来入库成功」了。
  status          String          @default("pending")
  error           String?         @db.Text
  chunkCount      Int             @default(0)
  /** 已向量化完成的 chunk 数（异步任务写回，用于上传后轮询进度） */
  processedChunks Int             @default(0)
  /** 解析后正文的 sha256：同一知识库内重复上传同一份文件时直接复用，不再重复向量化 */
  contentHash     String?
  /** 本文档 chunk 使用的 embedding 模型与维度（换模型后据此判断哪些 chunk 需要重建） */
  embeddingModel  String?
  embeddingDim    Int?
  createdAt       DateTime        @default(now())
  chunks          DocumentChunk[]
  tasks           RagTask[]

  @@unique([knowledgeBaseId, contentHash])
  @@index([knowledgeBaseId, createdAt])
  @@index([status])
}

model DocumentChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int // 文档内序号，用于展示与去重
  content    String            @db.Text
  /** chunk 正文的 sha256：embedding 缓存的键，也是跨文档复用的依据 */
  contentHash String?
  embedding  Float[] // 与 EMBEDDING_MODELS[].dimensions 对应
  /** 生成 embedding 的模型与维度（记录在 chunk 上，才能做按模型灰度重建） */
  embeddingModel String?
  embeddingDim   Int?
  /** pgvector 镜像列：仅 1024 维模型写入；Prisma 不支持 vector 类型，读写走 $queryRaw */
  embeddingVec   Unsupported("vector(1024)")?
  /** BM25 词项列：由 tokenizer.toLexemeText() 经 to_tsvector('simple', ?) 写入 */
  tsv            Unsupported("tsvector")?
  /** BM25 的文档长度 dl（token 数，含重复），长度归一化要用 */
  tokenCount     Int             @default(0)
  createdAt      DateTime        @default(now())

  @@index([documentId, index])
  @@index([contentHash])
  @@index([embeddingModel])
  // GIN 索引必须带 tsvector_ops，Prisma 不认默认 opclass，要显式声明
  @@index([tsv(ops: raw("tsvector_ops"))], type: Gin)
}

/// 入库 / 重建任务队列
///
/// 上传接口只负责「落一条 pending 文档 + 入队」，实际切分与向量化由 worker 执行。
/// 用 PostgreSQL 表当队列而不是引入 Redis/BullMQ：任务量级（每次上传一个文档）
/// 远达不到需要独立中间件的程度，而 FOR UPDATE SKIP LOCKED 已经能保证多实例下
/// 不会重复消费，也省掉一套需要额外运维的有状态组件。
model RagTask {
  id              String             @id @default(cuid())
  type            String // ingest | rebuild
  status          String             @default("queued") // queued | running | succeeded | failed
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeBaseId String?
  knowledgeBase   KnowledgeBase?     @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  documentId      String?
  document        KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /** 任务参数（ingest 会带上解析后的正文，因此上传接口的 1MB 上限也是任务载荷上限） */
  payload         Json
  priority        Int                @default(0)
  attempts        Int                @default(0)
  maxAttempts     Int                @default(3)
  progress        Int                @default(0)
  error           String?            @db.Text
  workerId        String?
  lockedAt        DateTime?
  /** 最早可执行时间：失败退避重试靠它实现，不需要独立的延迟队列 */
  runAfter        DateTime           @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, priority, runAfter])
  @@index([documentId])
  @@index([knowledgeBaseId, createdAt])
}

/// embedding 缓存（全局共享，按 内容哈希 + 模型 唯一）
///
/// 命中的是「同一段文本的向量」，命中者拿不到别人的原文（向量不含可还原的文本信息），
/// 因此不需要按用户隔离；跨用户共享的收益是重复内容（模板、规范条文、重复上传）只付一次钱。
model EmbeddingCache {
  id          String   @id @default(cuid())
  contentHash String
  model       String
  dim         Int
  embedding   Float[]
  /** 命中次数，用于评估缓存收益与清理策略 */
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  @@unique([contentHash, model])
  @@index([lastUsedAt])
}
